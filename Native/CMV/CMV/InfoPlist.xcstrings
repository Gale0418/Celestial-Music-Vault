{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleMusicUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "CMV connects with system media controls to display the track title, artist, and playback progress for your selected local or NAS media, and to receive system playback commands (such as pausing from Control Center). CMV does not browse, access, or modify your Apple Music library." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "CMVはシステムメディアコントロールと連動し、ユーザーが選択したローカルやNASメディアの曲名・アーティスト名・再生進捗を表示し、コントロールセンターからの再生・一時停止操作を受信します。Apple Musicライブラリの閲覧・アクセス・変更は一切行いません。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "CMV 與系統媒體控制項連動，為你自行選擇的本機或 NAS 媒體顯示曲名、藝人與播放進度，並接收來自控制中心的暫停或切歌等操作。CMV 不瀏覽、不讀取且不修改你的 Apple Music 曲庫。" } }
      }
    },
    "NSMotionUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "CMV uses device tilt for a subtle Saturn theme parallax effect. Motion data stays on your device." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "CMVは端末の傾きを使い、土星テーマに控えめな視差効果を加えます。モーションデータは端末内に保持されます。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "CMV 使用裝置傾斜，為土星主題呈現輕微視差。動作資料只留在你的裝置上。" } }
      }
    },
    "CFBundleDisplayName" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Celestial Music Vault" }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "Celestial Music Vault" }
        },
        "zh-Hant" : {
          "stringUnit" : { "state" : "translated", "value" : "星穹私藏音樂庫" }
        }
      }
    }
  },
  "version" : "1.0"
}
